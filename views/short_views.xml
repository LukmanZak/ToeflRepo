<odoo>
    <record id="english_short_list" model="ir.ui.view">
        <field name="name">english.short.list</field>
        <field name="model">english.short</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mode"/>
                <field name="topic"/>
                <field name="clip_title"/>
                <field name="state" widget="badge"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>

    <record id="english_short_form" model="ir.ui.view">
        <field name="name">english.short.form</field>
        <field name="model">english.short</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"
                            invisible="state in ('queued', 'generating')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Short name"/></h1></div>
                    <group>
                        <field name="mode" readonly="state in ('queued', 'generating')"/>
                        <field name="topic" placeholder="e.g. how beavers change rivers"
                               readonly="state in ('queued', 'generating')"/>
                        <field name="seconds_per_question" readonly="state in ('queued', 'generating')"/>
                        <field name="hook"/>
                        <field name="clip_title"/>
                        <field name="voices"/>
                        <field name="generated_at"/>
                    </group>
                    <div invisible="state not in ('queued', 'generating')" class="mb-3">
                        <field name="progress_html" widget="html" readonly="1" nolabel="1"/>
                    </div>
                    <field name="error_message" invisible="not error_message" widget="text"/>
                    <notebook>
                        <page string="Video" name="video">
                            <field name="video_html" widget="html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Questions" name="questions">
                            <field name="question_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="question"/>
                                    <field name="option_a"/>
                                    <field name="option_b"/>
                                    <field name="option_c"/>
                                    <field name="option_d"/>
                                    <field name="correct_answer"/>
                                    <field name="explanation_id" optional="show"/>
                                    <field name="explanation_en" optional="show"/>
                                    <field name="explanation_voice" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Script" name="script">
                            <field name="script" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_english_short" model="ir.actions.act_window">
        <field name="name">Shorts</field>
        <field name="res_model">english.short</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_english_section_root" name="English Section" sequence="40" groups="base.group_user"/>
    <menuitem id="menu_english_shorts" name="Shorts"
              parent="menu_english_section_root" action="action_english_short"/>
</odoo>
